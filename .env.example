# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials.

# Supabase project URL and anon/public key (Settings -> API in the Supabase
# dashboard). The anon key is safe to expose client-side by design, combined
# with Row Level Security policies on the notes table.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Password checked client-side before a note-delete request is sent. Low-stakes
# gate only (baked into the built JS bundle, inspectable by anyone who looks) —
# see the notepad admin-delete flow for the tradeoff.
VITE_ADMIN_PASSWORD=
